# Copy to .dev.vars for local development (`npm run dev`). Never commit .dev.vars.

# A passcode you make up. Anyone with it can read and change your runs.
APP_PASSCODE=

# Supabase → Project Settings → API. The service role key stays on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables POST /api/chat. https://build.nvidia.com → any model → "Get API Key"
NVIDIA_API_KEY=
