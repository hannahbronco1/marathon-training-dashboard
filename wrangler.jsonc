{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marathon-training-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Secrets (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, APP_PASSCODE) go in
  // .dev.vars locally and in Cloudflare's Variables and Secrets in
  // production. See README.md.
}
