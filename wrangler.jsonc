{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marathon-training-dashboard",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Non-secret settings. Secrets (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
  // NVIDIA_API_KEY, APP_PASSCODE) go in .dev.vars locally and
  // `wrangler secret put` in production. See README.md.
  "vars": {
    "NVIDIA_MODEL": "meta/llama-3.3-70b-instruct"
  }
}
